# Django Configuration
SECRET_KEY=django-insecure-change-this-in-production-ptah-portfolio-key-992384
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave empty or commented out for default SQLite in local development)
# Option A: Standard PostgreSQL URL
# DATABASE_URL=postgres://portfolio_user:portfolio_password@localhost:5432/portfolio_db
#
# Option B: Supabase PostgreSQL (Managed Cloud)
# Supabase Transaction Pooler (Recommended for serverless & container platforms like Railway/Render, port 6543):
# DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Direct Connection (Session mode, port 5432):
# DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Option C: Discrete connection parameters
# POSTGRES_DB=portfolio_db
# POSTGRES_USER=portfolio_user
# POSTGRES_PASSWORD=portfolio_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
#
# Advanced Database Tuning
# DB_CONN_MAX_AGE=600   # Set to 0 if using transaction poolers like PgBouncer / Supabase pooler
# DB_SSL_REQUIRE=True   # Automatically enabled for Supabase hosts

# Email Notification Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=portfolio@example.com
CONTACT_NOTIFICATION_EMAIL=

# Security (For Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.railway.app

